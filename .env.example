# ==============================================================================
# EchoNote Environment Configuration Template
# Copy this file to backend/.env and populate with your configuration.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///./echonote.db

# Storage Directories
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_SIZE_MB=250

# Audio & FFmpeg Configuration
# If ffmpeg is in your system PATH, leave blank for auto-detection
FFMPEG_PATH=
FFPROBE_PATH=

# Transcription Configuration
# Model options: tiny, base, small, medium, large
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# LLM Intelligence Configuration
# Provider options: mock, openai, gemini
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Processing Parameters
AUDIO_CHUNK_LENGTH_SEC=600
AUDIO_CHUNK_OVERLAP_SEC=10
