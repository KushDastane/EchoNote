# ==============================================================================
# EchoNote Backend Environment Configuration
# ==============================================================================

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default, can be switched to postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./echonote.db

# Storage
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_SIZE_MB=250

# FFmpeg Configuration (leave blank for auto-detection in PATH / winget directory)
FFMPEG_PATH=
FFPROBE_PATH=

# Whisper Model Configuration (tiny, base, small, medium, large)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# LLM Configuration
# Providers: mock (default for zero-cost offline/dev/testing), openai, gemini
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Audio Chunking
AUDIO_CHUNK_LENGTH_SEC=600
AUDIO_CHUNK_OVERLAP_SEC=10
